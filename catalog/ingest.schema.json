{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nibble catalog ingest v1",
  "type": "object",
  "required": [
    "version",
    "providers"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 3,
      "additionalProperties": false,
      "properties": {
        "Uber Eats": {
          "$ref": "#/$defs/snapshot"
        },
        "DoorDash": {
          "$ref": "#/$defs/snapshot"
        },
        "SkipTheDishes": {
          "$ref": "#/$defs/snapshot"
        }
      }
    }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "required": [
        "city",
        "region",
        "retrievedAt",
        "stores"
      ],
      "properties": {
        "city": {
          "const": "Fredericton"
        },
        "region": {
          "const": "NB"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "stores": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/store"
          }
        }
      }
    },
    "store": {
      "type": "object",
      "required": [
        "id",
        "name",
        "url",
        "menuItems"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "address": {
          "type": "string"
        },
        "menuItems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "observedAt": {
          "type": "string"
        },
        "retrievedAt": {
          "type": "string"
        },
        "directoryObservedAt": {
          "type": "string"
        },
        "sourceCrawlAgeAtRetrieval": {
          "type": "string"
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "name",
        "amountCents",
        "currency"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "amountCents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "const": "CAD"
        },
        "priceKind": {
          "enum": [
            "base",
            "from",
            "options"
          ]
        },
        "priceNote": {
          "type": "string"
        },
        "section": {
          "type": "string"
        }
      }
    }
  }
}
